<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="768" prefWidth="1229" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.ensicaen.genielogiciel.project.view.GameConfigurationView">

    <children>
        <ImageView fitHeight="768" fitWidth="1229" preserveRatio="false">
            <image>
                <Image url="@../images/BoatConfiguration.png" />
            </image>
        </ImageView>

        <Pane prefHeight="768" prefWidth="1229">
            <children>

                <Button fx:id="chooseFigaro1Button" layoutX="234.0" layoutY="310" onAction="#onChooseFigaro1" prefHeight="50.0" prefWidth="161.0" text="CHOOSE" />

                <Button fx:id="chooseFigaro2Button" layoutX="601.0" layoutY="310.0" onAction="#onChooseFigaro2" prefHeight="50.0" prefWidth="161.0" text="CHOOSE" />

                <Button fx:id="chooseOceanis1Button" layoutX="234.0" layoutY="665.0" onAction="#onChooseOceanis1" prefHeight="50.0" prefWidth="161.0" text="CHOOSE" />

                <Button fx:id="chooseOceanis2Button" layoutX="601.0" layoutY="665.0" onAction="#onChooseOceanis2" prefHeight="50.0" prefWidth="161.0" text="CHOOSE" />

                <Button fx:id="onePlayerButton" layoutX="1023.0" layoutY="252.0" onAction="#onOnePlayer" prefHeight="50.0" prefWidth="161.0" text="1" />

                <Button fx:id="twoPlayersButton" layoutX="1023.0" layoutY="335.0" onAction="#onTwoPlayers" prefHeight="50.0" prefWidth="161.0" text="2" />

                <Button fx:id="escapeButton" layoutX="1023.0" layoutY="567.0" onAction="#onEscape" prefHeight="50.0" prefWidth="161.0" text="ECHAP" />

                <Button fx:id="playButton" layoutX="1023.0" layoutY="631.0" onAction="#onPlay" prefHeight="50.0" prefWidth="161.0" text="PLAY !" />

            </children>
        </Pane>

    </children>
</StackPane>
