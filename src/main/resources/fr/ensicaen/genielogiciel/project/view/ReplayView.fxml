<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ensicaen.genielogiciel.project.view.EndGameView"
            stylesheets="@ReplayView.css"
            >

    <!-- This AnchorPane fills the entire window -->
    <AnchorPane fx:id="_replayView"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
    </AnchorPane>

    <ButtonBar layoutX="274.0" layoutY="700.0"
               prefHeight="40.0"
               prefWidth="352.0">
        <buttons>
            <Button id="_newGameBtn" mnemonicParsing="false"
                    onAction="#onClickStartNewGame"
                    prefHeight="26.0" prefWidth="104.0"
                    text="New Game" />
            <Button id="_quite" mnemonicParsing="false"
                    onAction="#onClickQuit"
                    text="Quit" />
            <Button id="_replayGameBtn" mnemonicParsing="false"
                    onAction="#onClickStartReplay"
                    text="Replay" />
        </buttons>
    </ButtonBar>
</AnchorPane>
