<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="492.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.ensicaen.genielogiciel.project.view.EndGameView">
    <children>

              <AnchorPane fx:id="_replayView" layoutY="-1.0" maxHeight="600" maxWidth="900">
        </AnchorPane>
      <ButtonBar layoutX="274.0" prefHeight="40.0" prefWidth="352.0">
        <buttons>
      
              <Button id="_newGameBtn" mnemonicParsing="false" onAction="#onClickStartNewGame" prefHeight="26.0" prefWidth="104.0" text="New Game" />
              <Button id="_quite" mnemonicParsing="false" onAction="#onClickQuit" text="Quit" />
            <Button id="_replayGameBtn" mnemonicParsing="false" onAction="#onClickStartReplay" text="Replay" />
        </buttons>
      </ButtonBar>
    </children>
</AnchorPane>
