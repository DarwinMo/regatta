<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<AnchorPane fx:id="_base"
            styleClass="water"
            stylesheets="@SpotMap.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.ensicaen.genielogiciel.project.view.GameView">


    <Button fx:id="pauseButton"
            text="Pause"
            prefWidth="100" prefHeight="40"
            style="-fx-font-size: 16px; -fx-background-color: black; -fx-text-fill: white;"
            AnchorPane.topAnchor="20"
            AnchorPane.rightAnchor="20"/>


    <Label fx:id="timeLabel"
           text="0.0ms"
           style="-fx-text-fill: white; -fx-font-size: 28px;"
           AnchorPane.topAnchor="20"
           AnchorPane.leftAnchor="0"
           AnchorPane.rightAnchor="0"
           alignment="CENTER"/>


    <VBox fx:id="Direction_Speed"
          AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20">

        <HBox spacing="6" alignment="CENTER_LEFT"
              AnchorPane.topAnchor="20"
              AnchorPane.leftAnchor="20">

            <ImageView fx:id="headingIcon"
                       fitWidth="30" fitHeight="30"
                       preserveRatio="true"/>
            <ImageView fx:id="headingArrow"
                       fitWidth="30" fitHeight="30"
                       preserveRatio="true"/>
            <ImageView fx:id="windIcon"
                       fitWidth="40" fitHeight="40"
                       preserveRatio="true"/>
            <ImageView fx:id="windArrow"
                       fitWidth="40" fitHeight="40"
                       preserveRatio="true"/>
        </HBox>


        <HBox spacing="6" alignment="BOTTOM_LEFT"
              AnchorPane.leftAnchor="20"
              AnchorPane.bottomAnchor="30">
            <Label fx:id="speedLabel"
                   text="0"
                   prefHeight="48"
                   style="-fx-text-fill: white; -fx-font-size: 48;"/>
            <Label
                    text="kt"
                    prefHeight="48"
                    style="-fx-text-fill: white; -fx-font-size: 24;"/>
        </HBox>
    </VBox>
</AnchorPane>
